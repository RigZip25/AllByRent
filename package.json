{
  "name": "evorios",
  "private": true,
  "version": "1.0.0",
  "description": "Evorios — Garage Showcase (PWA + Capacitor store apps)",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "prebuild": "node ./scripts/generate-rent-sitemap.mjs",
    "build": "tsc -b --pretty false && vite build",
    "build:native": "CAPACITOR_BUILD=1 npm run build && npx cap sync",
    "assets:generate": "capacitor-assets generate --ios --android --iconBackgroundColor '#062a1c' --iconBackgroundColorDark '#062a1c' --splashBackgroundColor '#062a1c' --splashBackgroundColorDark '#062a1c'",
    "typecheck": "tsc -b --pretty false",
    "dev": "vite",
    "dev:https": "set VITE_DEV_HTTPS=true&& vite",
    "lint": "node ./node_modules/eslint/bin/eslint.js src",
    "seo:sitemap": "node ./scripts/generate-rent-sitemap.mjs",
    "seo:indexnow": "node ./scripts/seo/submit-indexnow.mjs",
    "start": "vite",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
