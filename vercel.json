{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/legal/terms.html",
      "destination": "https://evorios.com/terms.html",
      "permanent": false
    },
    {
      "source": "/legal/privacy.html",
      "destination": "https://evorios.com/privacy.html",
      "permanent": false
    },
    {
      "source": "/legal/refunds.html",
      "destination": "https://evorios.com/refunds.html",
      "permanent": false
    },
    {
      "source": "/rent",
      "destination": "https://evorios.com/rent",
      "permanent": true
    },
    {
      "source": "/rent/:path*",
      "destination": "https://evorios.com/rent/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/link", "destination": "/link.html" },
    { "source": "/item/:id", "destination": "/link.html?listingId=:id&skipSplash=1" },
    {
      "source": "/__seo/rent",
      "destination": "/index.html"
    },
    {
      "source": "/__seo/rent/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|legal/|__seo/|\\.well-known/|sitemap\\.xml|robots\\.txt|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/workbox-:hash.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(self), geolocation=(self)"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rental-pending-expiry",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/rental-no-show",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/rental-overdue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/abandoned-listing-nudge",
      "schedule": "0 * * * *"
    }
  ]
}
