{
  "rewrites": [
    {
      "source": "/rent",
      "destination": "https://app.evorios.com/__seo/rent"
    },
    {
      "source": "/rent/:path*",
      "destination": "https://app.evorios.com/__seo/rent/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://app.evorios.com/assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://app.evorios.com/api/:path*"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "https://app.evorios.com/manifest.webmanifest"
    },
    {
      "source": "/pwa-:path*",
      "destination": "https://app.evorios.com/pwa-:path*"
    },
    { "source": "/cs", "destination": "/index-cs.html" },
    { "source": "/cs/", "destination": "/index-cs.html" },
    { "source": "/pl", "destination": "/index-pl.html" },
    { "source": "/pl/", "destination": "/index-pl.html" },
    { "source": "/sk", "destination": "/index-sk.html" },
    { "source": "/sk/", "destination": "/index-sk.html" },
    { "source": "/pt", "destination": "/index-pt.html" },
    { "source": "/pt/", "destination": "/index-pt.html" },
    { "source": "/es-mx", "destination": "/index-es-mx.html" },
    { "source": "/es-mx/", "destination": "/index-es-mx.html" }
  ],
  "headers": [
    {
      "source": "/rent/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
