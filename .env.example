# Copy to .env.local — never commit .env.local
#
# Server-side API keys (Vercel project env + local dev via Vite proxy to /api/*)
ANTHROPIC_API_KEY=
PHOTOROOM_API_KEY=
#
# Optional legacy names for local migration (prefer ANTHROPIC_API_KEY / PHOTOROOM_API_KEY)
# VITE_ANTHROPIC_API_KEY=
# VITE_PHOTOROOM_API_KEY=
#
# Owner ops console (/ops) — optional overrides (defaults exist in code for first login)
# VITE_OPS_USER=ed
# VITE_OPS_PASSWORD=

# Supabase (public anon key is safe in the client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
#
# Passkeys / Face ID (Vercel serverless only — never expose service role to the client)
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron + manual curl to /api/cron/* (openssl rand -hex 32)
CRON_SECRET=
PASSKEY_RP_ID=app.evorios.com
PASSKEY_ORIGIN=https://app.evorios.com
# Optional: override app origin for Stripe return URLs (defaults to PASSKEY_ORIGIN)
# APP_ORIGIN=https://app.evorios.com
# Optional: comma-separated extra origins (preview URLs, Play App Signing apk-key-hash, …)
# PASSKEY_ORIGINS=https://your-preview.vercel.app,android:apk-key-hash:YOUR_PLAY_SIGNING_HASH
# Optional: dedicated HMAC secret for WebAuthn challenges (else uses service role key)
# PASSKEY_SECRET=
#
# Stripe — client publishable key + server secrets
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
#
# Web push (public key is also shipped as a client fallback; private key must stay on Vercel only)
VITE_VAPID_PUBLIC_KEY=BH45waZHpiO_FiJjHMJfseI3nyNVyZscTYoq1dNYfdRSSKudNQP47kt76TcEgboKBmzUQQO7xzQCx5e464dCCwk
VAPID_PUBLIC_KEY=BH45waZHpiO_FiJjHMJfseI3nyNVyZscTYoq1dNYfdRSSKudNQP47kt76TcEgboKBmzUQQO7xzQCx5e464dCCwk
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@evorios.com

#
# Phone SMS KYC (Supabase Auth Phone provider — Twilio or MessageBird in Dashboard)
# Enable Authentication → Providers → Phone, then set:
PHONE_OTP_ENABLED=false
VITE_PHONE_OTP_ENABLED=false
# SUPABASE_SERVICE_ROLE_KEY is required to mark profiles.phone_verified after OTP
#
# Extra Stripe Identity badge (separate from Connect Express KYC). Default OFF.
VITE_STRIPE_IDENTITY_ENABLED=false
#
# Optional US license plate → VIN (PlateToVIN — https://platetovin.com).
# Free account + cached repeats; without this key hosts enter VIN manually
# and we still decode via free NHTSA vPIC at /api/vin/decode.
# PLATE_TO_VIN_API_KEY=
